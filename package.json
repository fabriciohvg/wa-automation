{
  "name": "wa-automation",
  "version": "0.1.0",
  "description": "Personal WhatsApp automation and backup to SQLite, built on Baileys",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
